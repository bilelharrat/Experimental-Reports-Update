# Build context hygiene. Without this the context is ~1GB (.git + .venv +
# node_modules + data/) and every build ships it to the daemon.

.git
.github
.DS_Store

# Python
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Node — the frontend build stage installs its own from package-lock.json.
node_modules
frontend/node_modules
frontend/dist

# Runtime state. Lives in a named volume, never in the image.
data

# Not read by anything under server/ at runtime.
docs
pres
tests
scripts

# Secrets / local config. .env is supplied at run time via env_file.
.env
.envrc
.claude
*.pem
