# BSH Research Center — environment variables.
# Copy to .env (gitignored) and adjust. Every variable is optional; the
# defaults noted here apply when unset. See README.md for auth details.

# --- Auth / access control -------------------------------------------------

# Local development WITHOUT credentials. Grants admin to anonymous requests.
# The API fails closed (401) without it. NEVER set in production.
BSH_ALLOW_ANON_DEV=1

# Session cookies are Secure by default; plain-http local dev needs this off.
BSH_COOKIE_SECURE=0

# Shared machine/tooling bearer token (read-only "service" role, never
# admin). Rotate to a long random secret or leave unset.
#BSH_RESEARCH_API_TOKEN=

# Password assigned to seed accounts at first materialization; unset means
# an unusable random password (operator sets real ones via
# `python -m server.auth_store set-password <email>`).
#BSH_BOOTSTRAP_PASSWORD=

# --- Memo pipeline ---------------------------------------------------------

# Fast parallel memo pipeline (default on). Set 0 for the monolithic path.
#BSH_MEMO_FAST_PIPELINE=1
# Auto-resume memo runs interrupted by a server restart (default on).
#BSH_MEMO_AUTO_RESUME=1
# Parallel translation of memo sections (default on).
#BSH_MEMO_BILINGUAL_PARALLEL=1
# Parallel per-section English package synthesis: a spine call pins shared
# numbers/sources/briefs, then one worker per section. Default OFF — live
# validation (NVIDIA 2026-08-21) showed no wall-clock win and ~5x cost per
# attempt vs the monolithic call; kept for future tuning.
#BSH_MEMO_ENGLISH_PARALLEL=0
# Concurrent section workers for the parallel English synthesis (default 5,
# one per memo section).
#BSH_MEMO_ENGLISH_SECTION_WORKERS=5
# Worker/retry tuning for the fast pipeline.
#BSH_MEMO_FAST_MAX_WORKERS=8
#BSH_MEMO_FAST_ENGLISH_PACKAGE_RETRIES=1
#BSH_MEMO_FAST_RETRY_BACKOFF_SEC=20
#BSH_MEMO_RESUME_PACKAGE_RETRIES=1

# --- Background job tuning -------------------------------------------------

# Seconds of progress-log silence before a job counts as stale/idle.
#BSH_ACTIVE_JOB_MAX_IDLE_SECONDS=900
#BSH_SEARCH_JOB_MAX_IDLE_SECONDS=180
# Research-task and trader-refresh parallelism.
#BSH_RESEARCH_TASK_CONCURRENCY=2
#BSH_TRADER_BULK_COMPANY_WORKERS=2
#BSH_TRADER_GLOBAL_LLM_WORKERS=4
#BSH_TRADER_SECTION_WORKERS_PER_COMPANY=2
# Regen-all backoff behavior on provider usage limits.
#BSH_REGEN_DEFAULT_BACKOFF_SECONDS=900
#BSH_REGEN_BACKOFF_MAX_SLEEP_SECONDS=3600
#BSH_REGEN_USAGE_WINDOW_SECONDS=18000
#BSH_REGEN_USAGE_WINDOW_PAUSE_FRACTION=0.85

# --- Document conversion ---------------------------------------------------

# PPT/PPTX→PDF preview conversion (macOS PowerPoint via AppleScript) and
# DOCX→PDF export timeouts (seconds), plus the staging dir for conversion.
#PPT_CONVERSION_TIMEOUT=180
#DOCX_PDF_TIMEOUT=180
#PPT_STAGE_DIR=
# Memo DOCX→PDF renderer backend selection.
#BSH_BROWSER_RENDERER=
