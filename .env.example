# BSH Research Center — environment variables.
# Copy to .env (gitignored) and adjust. Every variable is optional; the
# defaults noted here apply when unset. See README.md for auth details.

# --- Auth / access control -------------------------------------------------

# Local development WITHOUT credentials. Grants admin to anonymous requests.
# The API fails closed (401) without it. NEVER set in production.
BSH_ALLOW_ANON_DEV=1

# Optional display name when running anon-dev (avatar initials / Settings).
#BSH_ANON_DEV_NAME="Bilel Harrat"

# Session cookies are Secure by default; plain-http local dev needs this off.
BSH_COOKIE_SECURE=0

# Shared machine/tooling bearer token (read-only "service" role, never
# admin). Rotate to a long random secret or leave unset.
#BSH_RESEARCH_API_TOKEN=

# Password assigned to seed accounts at first materialization; unset means
# an unusable random password (operator sets real ones via
# `python -m server.auth_store set-password <email>`).
#BSH_BOOTSTRAP_PASSWORD=

# --- Memo pipeline ---------------------------------------------------------

# Fast parallel memo pipeline (default on). Set 0 for the monolithic path.
#BSH_MEMO_FAST_PIPELINE=1
# Auto-resume memo runs interrupted by a server restart (default on).
#BSH_MEMO_AUTO_RESUME=1
# Parallel translation of memo sections (default on).
#BSH_MEMO_BILINGUAL_PARALLEL=1
# Parallel per-section English package synthesis ("spine-lite"): a fast
# spine call pins the envelope (company/run/sources) plus a compact
# shared-facts sheet, then one worker per section plus a side agent for the
# private analysis artifacts. Default OFF — experimental; benchmark per
# docs/memo-benchmarks.md before enabling. (The pre-spine-lite variant lost
# its NVIDIA 2026-08-21 validation on cost; spine-lite is the retuned
# design.)
#BSH_MEMO_ENGLISH_PARALLEL=0
# Concurrent workers for the parallel English synthesis (default 6: five
# memo sections plus the analysis-artifacts agent).
#BSH_MEMO_ENGLISH_SECTION_WORKERS=6
# Chinese chasing: when the parallel English path is on, start each
# section's Chinese translation as soon as that section's English is
# drafted (attempt 1 only), then gap-fill whatever repairs invalidated.
# Default OFF; requires BSH_MEMO_ENGLISH_PARALLEL=1 to have any effect.
#BSH_MEMO_ZH_CHASING=0
#BSH_MEMO_ZH_CHASE_WORKERS=2
#BSH_MEMO_ZH_CHASE_JOIN_TIMEOUT_SEC=900
# Worker/retry tuning for the fast pipeline (workers default 8, clamp 1-8).
#BSH_MEMO_FAST_MAX_WORKERS=8
#BSH_MEMO_FAST_ENGLISH_PACKAGE_RETRIES=1
#BSH_MEMO_FAST_RETRY_BACKOFF_SEC=20
#BSH_MEMO_RESUME_PACKAGE_RETRIES=1

# Per-role model/effort for the memo subprocesses. Unset (the default)
# leaves every agent on the Claude CLI's configured default model and
# effort — exactly the historical behavior. BSH_MEMO_MODEL / BSH_MEMO_EFFORT
# apply to every role; a role-suffixed variant wins for that role. Roles:
# ANALYSIS_PASS (the 8 phase-2 passes), ENGLISH (monolithic synthesis),
# SPINE / SECTION / ARTIFACTS (parallel English), TRANSLATION (Chinese
# monolith + units), REPAIR (structure/quality repair).
# Models accept CLI aliases (opus, sonnet, haiku) or full ids; effort is
# low|medium|high|xhigh|max. Cheapest safe win: route the pure-translation
# units to Sonnet — English is authoritative and the merge is
# shape-conservative, so quality risk is low and cost drops ~2.5x.
# Caveat: prompt caches are model/effort-scoped — mixing models across
# SPINE/SECTION/ARTIFACTS forfeits their shared-context cache reuse.
#BSH_MEMO_MODEL=
#BSH_MEMO_EFFORT=
#BSH_MEMO_MODEL_TRANSLATION=claude-sonnet-5
#BSH_MEMO_EFFORT_TRANSLATION=medium

# --- Background job tuning -------------------------------------------------

# Seconds of progress-log silence before a job counts as stale/idle.
#BSH_ACTIVE_JOB_MAX_IDLE_SECONDS=900
#BSH_SEARCH_JOB_MAX_IDLE_SECONDS=180
# Research-task and trader-refresh parallelism.
#BSH_RESEARCH_TASK_CONCURRENCY=2
#BSH_TRADER_BULK_COMPANY_WORKERS=2
#BSH_TRADER_GLOBAL_LLM_WORKERS=4
#BSH_TRADER_SECTION_WORKERS_PER_COMPANY=2
# Regen-all backoff behavior on provider usage limits.
#BSH_REGEN_DEFAULT_BACKOFF_SECONDS=900
#BSH_REGEN_BACKOFF_MAX_SLEEP_SECONDS=3600
#BSH_REGEN_USAGE_WINDOW_SECONDS=18000
#BSH_REGEN_USAGE_WINDOW_PAUSE_FRACTION=0.85

# --- Document conversion ---------------------------------------------------

# PPT/PPTX→PDF preview conversion (macOS PowerPoint via AppleScript) and
# DOCX→PDF export timeouts (seconds), plus the staging dir for conversion.
#PPT_CONVERSION_TIMEOUT=180
#DOCX_PDF_TIMEOUT=180
#PPT_STAGE_DIR=
# Memo DOCX→PDF renderer backend selection.
#BSH_BROWSER_RENDERER=
