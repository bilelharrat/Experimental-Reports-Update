# BSH Research Center — environment variables.
# Copy to .env (gitignored) and adjust. Every variable is optional; the
# defaults noted here apply when unset. See README.md for auth details.

# --- Auth / access control -------------------------------------------------

# Local development WITHOUT credentials. Grants admin to anonymous requests.
# The API fails closed (401) without it. NEVER set in production.
BSH_ALLOW_ANON_DEV=1

# Optional display name when running anon-dev (avatar initials / Settings).
#BSH_ANON_DEV_NAME="Bilel Harrat"

# Session cookies are Secure by default; plain-http local dev needs this off.
BSH_COOKIE_SECURE=0

# Shared machine/tooling bearer token (read-only "service" role, never
# admin). Rotate to a long random secret or leave unset.
#BSH_RESEARCH_API_TOKEN=

# Password assigned to seed accounts at first materialization; unset means
# an unusable random password (operator sets real ones via
# `python -m server.auth_store set-password <email>`).
#BSH_BOOTSTRAP_PASSWORD=

# --- Memo pipeline ---------------------------------------------------------

# Fast parallel memo pipeline (default on). Set 0 for the monolithic path.
#BSH_MEMO_FAST_PIPELINE=1
# Auto-resume memo runs interrupted by a server restart (default on).
#BSH_MEMO_AUTO_RESUME=1
# Backfill missing company translations with Claude at every backend start
# (default on). Set 0 to stop restarts from spawning paid Claude CLI runs;
# note that deck intake and AI search do not translate inline, so those
# companies then stay untranslated in the Chinese view. Restarts spawn no
# Claude work only when this and BSH_MEMO_AUTO_RESUME are both 0.
#BSH_COMPANY_TRANSLATION_BACKFILL=1
# Parallel translation of memo sections (default on).
#BSH_MEMO_BILINGUAL_PARALLEL=1
# Parallel per-section English package synthesis ("spine-lite"): a fast
# spine call pins the envelope (company/run/sources) plus a compact
# shared-facts sheet, then one worker per section plus a side agent for the
# private analysis artifacts. Default OFF — experimental; benchmark per
# docs/memo-benchmarks.md before enabling. (The pre-spine-lite variant lost
# its NVIDIA 2026-08-21 validation on cost; spine-lite is the retuned
# design.)
#BSH_MEMO_ENGLISH_PARALLEL=0
# Concurrent workers for the parallel English synthesis (default 6: five
# memo sections plus the analysis-artifacts agent).
#BSH_MEMO_ENGLISH_SECTION_WORKERS=6
# Chinese chasing: when the parallel English path is on, start each
# section's Chinese translation as soon as that section's English is
# drafted (attempt 1 only), then gap-fill whatever repairs invalidated.
# Default OFF; requires BSH_MEMO_ENGLISH_PARALLEL=1 to have any effect.
#BSH_MEMO_ZH_CHASING=0
#BSH_MEMO_ZH_CHASE_WORKERS=4
#BSH_MEMO_ZH_CHASE_JOIN_TIMEOUT_SEC=900

# Round-2 speedup levers. All default OFF, all require
# BSH_MEMO_ENGLISH_PARALLEL=1; benchmark per docs/memo-benchmarks.md
# (Round 2) before enabling.
# Detach the private analysis-artifacts agent from the section wave: it
# starts at Phase-3 entry (overlapping the spine) and the wave never
# waits on it. If it is still running once the DOCX is rendered, the run
# marks the report complete ("report ready" — the jobs rail shows Done /
# finalizing artifacts) and collects the agent afterwards; the record
# keeps both timestamps (report_ready_at / run_finished_at).
#BSH_MEMO_ARTIFACTS_ASYNC=0
# Repair quality findings per-section in parallel (re-emits only the
# defective sections instead of the whole ~50-80KB package); unmappable
# findings fall back to the whole-package repair pass.
#BSH_MEMO_SECTIONAL_REPAIR=0
# Speculative spine: launch the spine once N of the 8 analysis passes
# have completed; when the stragglers land, a cheap delta check (role
# SPINE_CHECK) validates the pinned facts — stale pins discard the
# speculative spine and a normal one runs (bounded waste, one spine).
#BSH_MEMO_SPINE_SPECULATIVE=0
#BSH_MEMO_SPINE_SPECULATE_AFTER=6
# Pin-affine launch gate: on top of the count above, the spine waits for
# the pin-feeding passes (code default: arithmetic_denominators,
# time_base, growth_bridge, valuation_comps, exit_paths — the ones whose
# numbers land in the pin sheet). When they finish last the spine simply
# waits and the run degrades to normal spine timing. This variable ADDS
# comma-separated pass ids to that default — it cannot remove any (a
# stale override once pinned the pre-rebuild list and every v2 run lost
# ~10 min to a guaranteed stale respin); "none" restores count-only
# launch entirely.
#BSH_MEMO_SPINE_SPECULATE_REQUIRE=competitive_rights
# Early section starts: sections launch on the unvalidated speculative
# spine as soon as their affine passes finish. Requires
# BSH_MEMO_SPINE_SPECULATIVE=1. The riskiest lever — early sections
# never see the straggler passes; the pin-echo and quality gates stand
# behind it.
#BSH_MEMO_SECTION_EARLY_START=0

# Report structure v2 (the restructure): stage-classified profiles
# (late 12 sections / growth 9 / early 7) with the weighted scorecard,
# verdict tiers, fair-value pins, and Risk Card v2. Default OFF: every
# run writes the historical late v1 structure. Requires
# BSH_MEMO_ENGLISH_PARALLEL=1 (no monolithic twin exists for v2).
#BSH_MEMO_STRUCTURE_V2=0

# Per-run ceiling on concurrent memo Claude subprocesses. 10 is the
# hard cap; this can lower it, never raise it.
#BSH_MEMO_RUN_MAX_PROCS=10

# Deterministic pin-echo check: verifies the assembled package repeats
# the spine's pinned facts (recommendation verbatim, metric values, risk
# ratings, scenario numbers). Costs milliseconds; report-only by default
# (logs/pin_check.md + one stage event) wherever the parallel path wrote
# a spine. Set _REPAIR=1 to feed findings into the surgical-repair loop.
#BSH_MEMO_PIN_CHECK=1
#BSH_MEMO_PIN_CHECK_REPAIR=0

# Per-company fact ledger (the fact-lottery fix): when
# data/research/<company_slug>/fact_ledger.md exists, its text is
# injected verbatim into every analysis pass and the spine prompt, so
# dated headline facts no longer depend on lucky web retrieval. The
# file's presence is the real switch; this flag is the kill switch.
# The ledger is an input — freeze it within any A-vs-B benchmark.
#BSH_MEMO_FACT_LEDGER=1
# Tracked-news digest: memo workers refresh
# data/research/<company_slug>/recent_news.md from the tracking-updates
# store before Phase 2; it is injected like the fact ledger (passes +
# spine, never the shared section context). Kill switch:
#BSH_MEMO_TRACKED_NEWS=1

# News desk briefings. Opening or refreshing the News page never calls
# Claude: a story without an AI brief shows a basic brief pulled from the
# article without AI. AI briefs come from ONE worker (one headline at a
# time, one call writing English and Chinese, tools off) on this model and
# effort, for the top headlines clients last showed, every
# BSH_NEWS_BRIEF_REFRESH_HOURS (0 turns the schedule off; users can still
# start a refresh from the News page after a warning).
# Opening a story with no briefing writes one now (~12s on Gemini Flash),
# rather than showing the article's raw lead. Set to 0 for the old behavior,
# where only the 6-hour sweep and the Regenerate button call a model — but
# note the tape rotates in minutes, so on a 6-hour sweep the newest story
# essentially never has a briefing.
#BSH_NEWS_BRIEF_ON_OPEN=1

# These now pin the CLAUDE FALLBACK only — briefings run on Gemini first
# (see the Gemini section below); BSH_GEMINI_MODEL picks the Gemini model.
#BSH_NEWS_BRIEF_MODEL=sonnet
#BSH_NEWS_BRIEF_EFFORT=medium
#BSH_NEWS_BRIEF_REFRESH_HOURS=6
#BSH_NEWS_BRIEF_REFRESH_LIMIT=16

# Round-3 translation levers. Compact zh output: the translator returns
# ONLY the Chinese strings (a numbered array) and Python pastes them into
# the English structure — the legacy method re-emits the whole unit
# (English included), which measured ~38K output tokens / ~6 min for one
# section. Any compact failure falls back to the legacy method per unit.
# Units whose translatable English exceeds ZH_SPLIT_CHARS run as two
# parallel halves. Pair with BSH_MEMO_EFFORT_TRANSLATION=medium.
#BSH_MEMO_ZH_COMPACT=0
#BSH_MEMO_ZH_SPLIT_CHARS=20000
# Worker/retry tuning for the fast pipeline (workers default 8, clamp 1-8).
#BSH_MEMO_FAST_MAX_WORKERS=8
#BSH_MEMO_FAST_ENGLISH_PACKAGE_RETRIES=1
#BSH_MEMO_FAST_RETRY_BACKOFF_SEC=20
#BSH_MEMO_RESUME_PACKAGE_RETRIES=1

# Per-role model/effort for the memo subprocesses. Unset (the default)
# leaves every agent on the Claude CLI's configured default model and
# effort — exactly the historical behavior. BSH_MEMO_MODEL / BSH_MEMO_EFFORT
# apply to every role; a role-suffixed variant wins for that role. Roles:
# ANALYSIS_PASS (the 8 phase-2 passes), ENGLISH (monolithic synthesis),
# SPINE / SECTION / ARTIFACTS (parallel English), SPINE_CHECK (the
# speculative-spine delta verifier — small judgment call, Sonnet is a
# good fit), TRANSLATION (Chinese monolith + units), REPAIR
# (structure/quality repair, whole-package and sectional).
# Models accept CLI aliases (opus, sonnet, haiku) or full ids; effort is
# low|medium|high|xhigh|max. Cheapest safe win: route the pure-translation
# units to Sonnet — English is authoritative and the merge is
# shape-conservative, so quality risk is low and cost drops ~2.5x.
# Caveat: prompt caches are model/effort-scoped — mixing models across
# SPINE/SECTION/ARTIFACTS forfeits their shared-context cache reuse.
# The per-run "Quality" toggle (best/balanced/economy) fills in models
# for roles these vars leave unset; anything set here always wins over
# the selected tier. "best" (the default) applies no tier values at all.
#BSH_MEMO_MODEL=
#BSH_MEMO_EFFORT=
#BSH_MEMO_MODEL_TRANSLATION=claude-sonnet-5
#BSH_MEMO_EFFORT_TRANSLATION=medium

# --- Background job tuning -------------------------------------------------

# Seconds of progress-log silence before a job counts as stale/idle.
#BSH_ACTIVE_JOB_MAX_IDLE_SECONDS=900
#BSH_SEARCH_JOB_MAX_IDLE_SECONDS=180
# Background sync for starred (tracked) companies, every
# BSH_TRACKING_SYNC_INTERVAL_SECONDS (default 12 hours; the clock survives
# restarts). It refreshes each company's news with a Claude web search,
# has Claude judge which new items matter, and records a recommended Deep
# Investigate or full report. Nothing launches on its own unless auto-apply
# is on: the toggle in a company's News tab decides, and
# BSH_TRACKING_AUTO_EXECUTE only sets the default before anyone uses it.
#BSH_TRACKING_AUTO_SYNC=1
#BSH_TRACKING_SYNC_INTERVAL_SECONDS=43200
#BSH_TRACKING_AUTO_EXECUTE=0
# Re-run company deep-search before syncing news (costs Claude; default on).
#BSH_TRACKING_REFRESH_NEWS=1
#BSH_TRACKING_NEWS_MODEL=sonnet
#BSH_TRACKING_NEWS_EFFORT=medium
# Impact judgment and decision reassessment (0 on IMPACT_AI falls back to
# keyword rules for impact).
#BSH_TRACKING_IMPACT_AI=1
#BSH_TRACKING_IMPACT_MODEL=claude-opus-5
#BSH_TRACKING_IMPACT_EFFORT=medium
# Research-task and trader-refresh parallelism.
#BSH_RESEARCH_TASK_CONCURRENCY=2
#BSH_TRADER_BULK_COMPANY_WORKERS=2
#BSH_TRADER_GLOBAL_LLM_WORKERS=4
#BSH_TRADER_SECTION_WORKERS_PER_COMPANY=2
# Regen-all backoff behavior on provider usage limits.
#BSH_REGEN_DEFAULT_BACKOFF_SECONDS=900
#BSH_REGEN_BACKOFF_MAX_SLEEP_SECONDS=3600
#BSH_REGEN_USAGE_WINDOW_SECONDS=18000
#BSH_REGEN_USAGE_WINDOW_PAUSE_FRACTION=0.85

# --- Market desk -------------------------------------------------------------

# Server-side alert engine poll interval (seconds). Unset/0 disables the
# background thread; alerts are then only evaluated on demand via
# POST /api/alerts/check. Minimum effective interval is 30s.
#BSH_ALERT_ENGINE_INTERVAL=300

# --- Co-Pilot / Ask (quick mode) --------------------------------------------
# Applies to web Co-Pilot Inspect (copilot_quick) and iOS Ask
# (copilot_quick_ios). Deep Console ignores these and keeps full tools +
# default model. CLI aliases: haiku | sonnet | opus (or full model ids).
#
# Defaults (when unset): model=sonnet, effort=low.
# Speed ranking with tools off: haiku (fastest/cheapest) < sonnet (default
# quality/speed compromise) < opus (best answers, noticeably slower).
# Tools-off is the main latency lever — iOS defaults to empty --tools
# (~fastest time-to-done); web quick defaults to Read-only so hydrated
# dossier files still work. Raising effort (medium/high) hurts latency
# more than switching haiku→sonnet with tools still empty.
#BSH_COPILOT_QUICK_MODEL=sonnet
#BSH_COPILOT_QUICK_EFFORT=low
#BSH_COPILOT_QUICK_TOOLS=Read
#BSH_COPILOT_IOS_TOOLS=
# Tune: BSH_COPILOT_QUICK_MODEL=haiku for max speed; =opus for max quality.
# BSH_COPILOT_IOS_TOOLS=Read re-enables file reads on iPhone (slower).

# --- Document conversion ---------------------------------------------------

# PPT/PPTX→PDF preview conversion (macOS PowerPoint via AppleScript) and
# DOCX→PDF export timeouts (seconds), plus the staging dir for conversion.
#PPT_CONVERSION_TIMEOUT=180
#DOCX_PDF_TIMEOUT=180
#PPT_STAGE_DIR=
# Memo DOCX→PDF renderer backend selection.
#BSH_BROWSER_RENDERER=

# --- Distribution / push ----------------------------------------------------

# Public HTTPS origin for the hosted API (docs/DISTRIBUTION.md). Not read by
# the container automatically — set iOS BSHBaseURL / Settings to this value.
#BSH_PUBLIC_BASE_URL=https://research.example.com

# Optional APNs credentials for memo/brief/ask/alert pushes (server/push_notify.py).
#BSH_APNS_KEY_ID=
#BSH_APNS_TEAM_ID=
#BSH_APNS_BUNDLE_ID=com.bilelharrrat.bshresearch
#BSH_APNS_KEY_PATH=/path/to/AuthKey_XXXXX.p8
#BSH_APNS_KEY_PEM=
#BSH_APNS_USE_SANDBOX=1

# --- Gemini engine (Team dossier, desk note, company news sweep) ------------

# Three research surfaces run on Google Gemini Flash rather than the Claude
# CLI: the Research Desk Team tab's Refresh (server/founder_dossier.py), the
# Morning Brief's written note (server/market_brief.py), and the company news
# sweep (server/company_news_research.py). They are web-grounded and
# high-frequency, which the metered Flash API serves better than a CLI
# subprocess spending the Claude Code subscription.
#
# Without a key these surfaces fall back to Claude automatically and say so
# (each payload carries the engine that produced it), so an unset key
# degrades rather than breaks. Get one at https://aistudio.google.com/apikey.
#GEMINI_API_KEY=

# Engine policy. gemini (default) = Gemini first, Claude on failure;
# gemini-only = no Claude fallback, a failure is an error; claude = the
# pre-Gemini behavior, Gemini never called.
#BSH_AI_ENGINE=gemini

# Model and reasoning level. Flash rejects `minimal`; low | medium | high.
#BSH_GEMINI_MODEL=gemini-3.8-flash
#BSH_GEMINI_THINKING=low

# Reasoning level for the WEB-GROUNDED calls (Team dossier, news sweep) —
# separate because whether the model actually calls google_search depends on
# it, and not monotonically. Measured against the live API: `low` and `high`
# both answered from model memory with zero searches; `medium` searched every
# time. Do not lower this to save tokens — an ungrounded answer here reads as
# research while being unsourced recall.
#BSH_GEMINI_GROUNDED_THINKING=medium
